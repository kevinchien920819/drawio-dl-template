elative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0_c141" value="\(\mathrm{sim}(c_t, q) = \frac{c_t^{\top} q}{\lVert c_t \rVert\, \lVert q \rVert}\)&amp;nbsp; for \(q \in \{q_t\} \cup \tilde{Q}_t\)&amp;nbsp; (\(K = 100\) distractors from other masked steps)" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="135.0" y="194.0" width="760.0" height="46.0" as="geometry"/></mxCell><mxCell id="p0_c142" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=4;strokeColor=#4d4d4d;strokeWidth=1.2;jumpStyle=arc;jumpSize=6;fontSize=9;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.1842;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_c137" target="p0_c141"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0_c143" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=4;strokeColor=#4d4d4d;strokeWidth=1.2;jumpStyle=arc;jumpSize=6;fontSize=9;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.8158;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_c139" target="p0_c141"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0_c144" value="Contrastive loss (masked \(t\))&lt;br&gt;\(\mathcal{L}_m = -\log \frac{\exp(\mathrm{sim}(c_t, q_t)/\kappa)}{\sum_{\tilde q \in Q_t} \exp(\mathrm{sim}(c_t, \tilde q)/\kappa)}\)" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#6d8f2e;fontFamily=Helvetica;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="175.0" y="98.0" width="400.0" height="66.0" as="geometry"/></mxCell><mxCell id="p0_c145" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=blockThin;endFill=1;endSize=4;strokeColor=#4d4d4d;strokeWidth=1.2;jumpStyle=arc;